# Cloud Build uploads this directory as the build context. Without this file it
# would ship ~2 GB: a 1.3 GB folder of evaluation renders, two virtualenvs and
# node_modules — none of which belong in a container.
.git/
.gitignore
**/node_modules/
**/.next/
**/.venv/
**/__pycache__/
**/*.pyc
.logs/
*.log

# Measurement artefacts: hundreds of PNG renders from the prompt eval rounds.
services/agent/evaluation/results/

# The proxied listing photos re-download on demand; 317 MB of cache does not
# need to be in the image.
services/agent/data/image-cache/

# SQLite sidecars are not portable between machines; the .db itself is baked in
# deliberately (see infra/Dockerfile.backend).
services/agent/data/*.db-wal
services/agent/data/*.db-shm

# Local secrets never enter an image. Cloud Run gets them as env vars.
.env
.env.*
.claude/
*.pdf
